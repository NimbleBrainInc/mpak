{
  "name": "@nimblebrain/mpak-registry",
  "version": "0.1.0",
  "description": "mpak registry server - bundle and MCP server registry",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts | npx pino-pretty",
    "build": "npm run db:generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "ingest:mcp-registry": "node dist/jobs/ingest-mcp-registry.js",
    "ingest:mcp-registry:dev": "dotenv -e .env -- tsx src/jobs/ingest-mcp-registry.ts",
    "clean": "rm -rf dist"
  },
  "license": "Apache-2.0",
  "author": "NimbleBrain Inc <engineering@mpak.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/NimbleBrainInc/mpak.git",
    "directory": "apps/registry"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/cloudfront-signer": "^3.1166.0",
    "@clerk/backend": "^3.28.0",
    "@fastify/cors": "^11.4.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@kubernetes/client-node": "^1.4.0",
    "@nimblebrain/mpak-schemas": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "semver": "^7.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv-cli": "^11.1.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
